local Corners = {}
local GlassObjects = {}
local Notifications = {}

local function create(className, properties, parent)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    object.Parent = parent
    return object
end

local function tween(object, duration, properties, style)
    local info = TweenInfo.new(
        duration or 0.2,
        style or Enum.EasingStyle.Quad,
        Enum.EasingDirection.Out
    )
    local animation = TweenService:Create(object, info, properties)
    animation:Play()
    return animation
end

local function addCorner(object, radius)
    local corner = create("UICorner", {
        CornerRadius = UDim.new(0, radius or NOVAS.CornerRadius)
    }, object)
    table.insert(Corners, corner)
    return corner
end

local function addStroke(object, color, thickness, transparency)
    local stroke = create("UIStroke", {
        Color = color or NOVAS.Theme.Border,
        Thickness = thickness or 1,
        Transparency = transparency or 0.2
    }, object)

    if color == NOVAS.Theme.Accent then
        table.insert(AccentObjects, {
            Object = stroke,
            Property = "Color"
        })
    end

    return stroke
end

local function addAccent(object, property)
    table.insert(AccentObjects, {
        Object = object,
        Property = property
    })
end

local function applyGlass()
    for _, entry in ipairs(GlassObjects) do
        local object = entry.Object
        if object and object.Parent then
            if NOVAS.GlassEnabled then
                object.BackgroundTransparency = NOVAS.GlassTransparency
            else
                object.BackgroundTransparency = entry.SolidTransparency or 0
            end
        end
    end
end

function NOVAS:SetAccent(color)
    if typeof(color) ~= "Color3" then
        return
    end

    NOVAS.Theme.Accent = color
    NOVAS.Theme.AccentLight = color:Lerp(Color3.new(1, 1, 1), 0.4)

    for _, entry in ipairs(AccentObjects) do
        if entry.Object and entry.Object.Parent then
            pcall(function()
                entry.Object[entry.Property] = color
            end)
        end
    end
end

function NOVAS:SetGlass(enabled)
    NOVAS.GlassEnabled = enabled == true
    applyGlass()
end

function NOVAS:SetGlassTransparency(value)
    NOVAS.GlassTransparency = math.clamp(value, 0, 0.95)
    applyGlass()
end

function NOVAS:SetCornerRadius(value)
    NOVAS.CornerRadius = math.clamp(value, 0, 30)

    for _, corner in ipairs(Corners) do
        if corner and corner.Parent then
            corner.CornerRadius = UDim.new(0, NOVAS.CornerRadius)
        end
    end
end

function NOVAS:Notify(data)
    data = data or {}

    local title = data.Title or "NOVAS GUI"
    local content = data.Content or ""
    local duration = data.Duration or 3

    local gui = PlayerGui:FindFirstChild("NOVAS_Notifications")
    if not gui then
        gui = create("ScreenGui", {
            Name = "NOVAS_Notifications",
            ResetOnSpawn = false,
            IgnoreGuiInset = true,
            DisplayOrder = 100
        }, PlayerGui)
    end

    local frame = create("Frame", {
        Size = UDim2.new(0, 270, 0, 78),
        Position = UDim2.new(1, 290, 1, -100),
        BackgroundColor3 = NOVAS.Theme.Panel,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0
    }, gui)

    addCorner(frame, 12)
    addStroke(frame, NOVAS.Theme.Accent, 1.4)

    local bar = create("Frame", {
        Size = UDim2.new(0, 4, 1, -18),
        Position = UDim2.new(0, 8, 0, 9),
        BackgroundColor3 = NOVAS.Theme.Accent,
        BorderSizePixel = 0
    }, frame)
    addCorner(bar, 4)
    addAccent(bar, "BackgroundColor3")

    create("TextLabel", {
        Size = UDim2.new(1, -34, 0, 25),
        Position = UDim2.new(0, 22, 0, 9),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = NOVAS.Theme.Text,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left
    }, frame)

    create("TextLabel", {
        Size = UDim2.new(1, -34, 0, 34),
        Position = UDim2.new(0, 22, 0, 34),
        BackgroundTransparency = 1,
        Text = content,
        TextColor3 = NOVAS.Theme.Muted,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top
    }, frame)

    tween(frame, 0.35, {
        Position = UDim2.new(1, -290, 1, -100)
    }, Enum.EasingStyle.Back)

    task.delay(duration, function()
        if frame and frame.Parent then
            tween(frame, 0.25, {
                Position = UDim2.new(1, 290, 1, -100),
                BackgroundTransparency = 1
            })
            task.wait(0.3)
            if frame then
                frame:Destroy()
            end
        end
    end)
end

local function makeText(parent, text, size, color, bold)
    return create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextColor3 = color or NOVAS.Theme.Text,
        TextSize = size or 13,
        Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center
    }, parent)
end

local function makeButton(parent, text, size)
    local button = create("TextButton", {
        Size = size or UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = NOVAS.Theme.Secondary,
        BackgroundTransparency = 0.15,
        BorderSizePixel = 0,
        Text = text or "Button",
        TextColor3 = NOVAS.Theme.Text,
        TextSize = 12,
        Font = Enum.Font.GothamSemibold,
        AutoButtonColor = false
    }, parent)

    addCorner(button, NOVAS.CornerRadius)
    addStroke(button, NOVAS.Theme.Border, 1, 0.45)

    button.MouseEnter:Connect(function()
        tween(button, 0.15, {
            BackgroundColor3 = NOVAS.Theme.Accent
        })
    end)

    button.MouseLeave:Connect(function()
        tween(button, 0.15, {
            BackgroundColor3 = NOVAS.Theme.Secondary
        })
    end)

    return button
end

