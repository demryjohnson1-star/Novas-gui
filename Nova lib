    Accent = Color3.fromRGB(155, 80, 255),
    AccentLight = Color3.fromRGB(205, 145, 255),
    Text = Color3.fromRGB(245, 240, 255),
    Muted = Color3.fromRGB(160, 150, 180),
    Border = Color3.fromRGB(100, 65, 150),
