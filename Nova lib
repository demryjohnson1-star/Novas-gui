local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local Purple = Color3.fromRGB(145, 75, 255)
local LightPurple = Color3.fromRGB(195, 145, 255)
local Dark = Color3.fromRGB(19, 17, 27)
local Panel = Color3.fromRGB(29, 25, 39)
local White = Color3.fromRGB(245, 240, 255)

local function Create(class, props, parent)
    local obj = Instance.new(class)

    for key, value in pairs(props or {}) do
        obj[key] = value
    end

    obj.Parent = parent
    return obj
end

local function Corner(parent, radius)
    return Create("UICorner", {
        CornerRadius = UDim.new(0, radius or 10)
    }, parent)
end

local function Stroke(parent, color, thickness)
    return Create("UIStroke", {
        Color = color or Purple,
        Thickness = thickness or 1,
        Transparency = 0.2
    }, parent)
end

local function Tween(object, duration, properties)
    local tween = TweenService:Create(
        object,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out
        ),
        properties
    )

    tween:Play()
    return tween
end

local function Label(parent, text, size, position, textSize)
    return Create("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        Size = size,
        Position = position,
        Font = Enum.Font.Gotham,
        TextSize = textSize or 13,
        TextColor3 = White,
        TextXAlignment = Enum.TextXAlignment.Left
    }, parent)
end

-- Notifications

function NOVAS:Notify(options)
    options = options or {}

    local title = options.Title or "NOVAS"
    local content = options.Content or "Notification"
    local duration = options.Duration or 3

    local gui = Create("ScreenGui", {
        Name = "NOVAS_Notifications",
        ResetOnSpawn = false,
        DisplayOrder = 100
    }, PlayerGui)

    local frame = Create("Frame", {
        Size = UDim2.new(0, 280, 0, 85),
        Position = UDim2.new(1, 320, 1, -110),
        BackgroundColor3 = Panel,
        BackgroundTransparency = 0.12,
        BorderSizePixel = 0
    }, gui)

    Corner(frame, 12)
    Stroke(frame, Purple, 1.5)

    Create("UIGradient", {
        Color = ColorSequence.new({
            ColorSequenceKeypoint.new(
                0,
                Color3.fromRGB(54, 35, 82)
            ),
            ColorSequenceKeypoint.new(1, Dark)
        }),
        Rotation = 35
    }, frame)

    local accent = Create("Frame", {
        Size = UDim2.new(0, 4, 1, -20),
        Position = UDim2.new(0, 8, 0, 10),
        BackgroundColor3 = LightPurple,
        BorderSizePixel = 0
    }, frame)

    Corner(accent, 5)

    Label(
        frame,
        title,
        UDim2.new(1, -35, 0, 25),
        UDim2.new(0, 22, 0, 12),
        15
    )

    local message = Label(
        frame,
        content,
        UDim2.new(1, -35, 0, 35),
        UDim2.new(0, 22, 0, 39),
        12
    )

    message.TextColor3 = Color3.fromRGB(195, 185, 210)
    message.TextWrapped = true

    Tween(frame, 0.45, {
        Position = UDim2.new(1, -300, 1, -110)
    })

    task.delay(duration, function()
        if frame.Parent then
            Tween(frame, 0.35, {
                Position = UDim2.new(1, 320, 1, -110),
                BackgroundTransparency = 1
            })

            task.wait(0.4)
            gui:Destroy()
        end
    end)

    return gui
end

